{
  "database": {
    "rules": "firebase/database.rules.json"
  },
  "storage": {
    "rules": "firebase/storage.rules"
  },
  "hosting": {
    "public": "build/firebase-preview",
    "ignore": [
      "firebase-debug.log",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "**/*.html",
        "headers": [{"key": "Cache-Control", "value": "no-store"}]
      },
      {
        "source": "**/*.webmanifest",
        "headers": [{"key": "Cache-Control", "value": "no-store"}]
      }
    ]
  }
}
