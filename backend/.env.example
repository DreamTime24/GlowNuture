# Fresh keys are generated by scripts/setup_local.py. Never commit private .env values.
APP_ENV=development
DATABASE_URL=sqlite:///./glownuture.db
# Production: reuse an approved existing PostgreSQL instance.
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/glownuture
ALLOWED_ORIGIN=http://127.0.0.1:8000
COOKIE_SECURE=false
PII_ENCRYPTION_KEY=REPLACE_WITH_FERNET_KEY
PII_HMAC_KEY=REPLACE_WITH_64_HEX_CHAR_SECRET
AUTO_CREATE_SCHEMA=false
SEED_DEMO_PRODUCTS=false
LOCAL_AUTH_ENABLED=false
ADMIN_BOOTSTRAP_PHONE=
ADMIN_BOOTSTRAP_PASSWORD=
CHECKOUT_ENABLED=false
SELLER_LEGAL_NAME=
SELLER_ADDRESS=
SUPPORT_EMAIL=
SUPPORT_PHONE=
COD_ENABLED=true
SHIPPING_DHAKA=60
SHIPPING_OUTSIDE=120
FREE_SHIPPING_THRESHOLD=2500
TAX_PERCENT=0
# Firebase web configuration is public, but is configured outside source code.
FIREBASE_ENABLED=false
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=glownuture-f157c.firebaseapp.com
FIREBASE_PROJECT_ID=glownuture-f157c
FIREBASE_STORAGE_BUCKET=glownuture-f157c.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=967903213091
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=
FIREBASE_DATABASE_URL=https://glownuture-f157c-default-rtdb.asia-southeast1.firebasedatabase.app/
FIREBASE_VAPID_KEY=
FIREBASE_GOOGLE_ENABLED=true
FIREBASE_FACEBOOK_ENABLED=false
ENFORCE_ADMIN_MFA=true
# Prefer server workload identity / ADC. Never paste a service-account private key into code.
# Export GOOGLE_APPLICATION_CREDENTIALS in the server process environment if using an existing private credential file.
RECAPTCHA_ENABLED=false
RECAPTCHA_MODE=v2
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET=
APP_CHECK_ENFORCE=false
APP_CHECK_SITE_KEY=
# Optional approved local The Ordinary collection (always BDT); no raw external products are public.
CATALOG_REFERENCE_ENABLED=false
CATALOG_MAX_PAGES=5
# Persistent private volume path; blank uses frontend/media for local development.
MEDIA_ROOT=
# Rotate the previously exposed Parse key first, then set both values privately.
PARSE_KEY_ROTATION_CONFIRMED=false
PARSE_API_KEY=
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_LIVE=false
SSLCOMMERZ_LIVE_VERIFIED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
AI_ENABLED=false
ANALYTICS_ENABLED=false
JOURNAL_ENABLED=false
