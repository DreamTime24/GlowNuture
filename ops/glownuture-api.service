# Template only. Install after the owner approves the server and exact paths.
[Unit]
Description=GlowNuture API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=glownuture
Group=glownuture
WorkingDirectory=/srv/glownuture/current/backend
EnvironmentFile=/etc/glownuture/store.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/srv/glownuture/current/.venv/bin/python -m uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 1 --proxy-headers --forwarded-allow-ips 127.0.0.1 --no-access-log
Restart=on-failure
RestartSec=5
TimeoutStopSec=40
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/srv/glownuture/shared/media
UMask=0027

[Install]
WantedBy=multi-user.target
